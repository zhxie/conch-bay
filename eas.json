{
  "cli": {
    "version": ">= 3.0.0",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "env": {
        "APP_VARIANT": "development"
      },
      "distribution": "internal"
    },
    "internal": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview"
    },
    "preview": {
      "channel": "production",
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1659268579"
      }
    }
  }
}
